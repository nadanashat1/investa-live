{
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/index.mjs" }],
  "redirects": [{ "source": "/", "destination": "/app/", "permanent": false }],
  "headers": [{ "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "X-Frame-Options", "value": "DENY" }, { "key": "Referrer-Policy", "value": "no-referrer" }, { "key": "Strict-Transport-Security", "value": "max-age=15552000" }] }]
}
